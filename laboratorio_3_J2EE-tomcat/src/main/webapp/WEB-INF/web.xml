<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" version="3.1"
	xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
         http://xmlns.jcp.org/xml/ns/javaee/web-app_3_1.xsd">

	<welcome-file-list>
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>

	<resource-ref>
		<description>Conexão com o banco via JNDI</description>
		<res-ref-name>jdbc/lab3</res-ref-name>
		<res-type>javax.sql.DataSource</res-type>
		<res-auth>Container</res-auth>
	</resource-ref>

	<servlet>
		<servlet-name>BancoServlet</servlet-name>
		<servlet-class>servlet.BancoServlet</servlet-class>
	</servlet>

	<servlet-mapping>
		<servlet-name>BancoServlet</servlet-name>
		<url-pattern>/banco</url-pattern>
	</servlet-mapping>

</web-app>